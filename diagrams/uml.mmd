classDiagram
    %% PawPal system classes
    class Owner {
        -str name
        -str email
        -str phone
        -list~Pet~ pets
        +get_name() str
        +get_pets() list~Pet~
        +add_pet(pet: Pet) None
        +remove_pet(pet: Pet) None
        +find_pet(name: str) Pet
        +get_all_tasks() list~Task~
        +get_contact_info() str
    }

    class Pet {
        -str name
        -str species
        -str breed
        -int age
        -str status
        -Owner owner
        -list~Task~ tasks
        +get_name() str
        +get_owner() Owner
        +get_species() str
        +get_age() int
        +get_status() str
        +set_status(status: str) None
        +add_task(task: Task) None
        +remove_task(task: Task) None
        +get_tasks() list~Task~
    }

    class Task {
        -str task_name
        -str description
        -datetime time
        -int duration_minutes
        -Priority priority
        -Frequency frequency
        -TaskStatus status
        -Pet pet
        +get_task_name() str
        +get_time() datetime
        +set_time(time: datetime) None
        +get_priority() Priority
        +set_task_status(status: TaskStatus) None
        +mark_complete() None
        +is_complete() bool
        +is_overdue(now: datetime) bool
        +overlaps(other: Task) bool
        +next_occurrence() Task
    }

    class Scheduler {
        -Owner owner
        +add_task(pet: Pet, task: Task) None
        +remove_task(task: Task) None
        +get_all_tasks() list~Task~
        +get_tasks_for_pet(pet: Pet) list~Task~
        +get_tasks_for_day(day: date) list~Task~
        +get_pending_tasks() list~Task~
        +sort_by_time() list~Task~
        +sort_by_priority() list~Task~
        +detect_conflicts() list~tuple~
        +generate_daily_plan(day: date) list~Task~
        +complete_task(task: Task) Task
    }

    class Priority {
        <<enumeration>>
        HIGH
        MEDIUM
        LOW
    }

    class TaskStatus {
        <<enumeration>>
        PENDING
        COMPLETE
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    %% Two-way links: Owner.pets <-> Pet.owner, Pet.tasks <-> Task.pet
    Owner "1" <--> "0..*" Pet : owns
    Pet "1" <--> "0..*" Task : has
    Scheduler "1" --> "1" Owner : plans for
    Scheduler ..> Task : reads via Owner.get_all_tasks()
    Task --> Priority
    Task --> TaskStatus
    Task --> Frequency
